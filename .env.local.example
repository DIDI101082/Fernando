# Supabase — copiá estos valores desde tu proyecto en supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WhatsApp — número en formato internacional sin "+" (ej: 5491123456789)
NEXT_PUBLIC_WA_NUMBER=5491100000000

# Nombre del negocio (aparece en el header y footer)
NEXT_PUBLIC_SHOP_NAME=El Almacén
